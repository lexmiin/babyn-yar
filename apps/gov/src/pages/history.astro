---
import HistoryMap from '@/components/history-map/HistoryMap'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import before1941 from '@/assets/history-map/base_map_layer_1.png'
import occupation from '@/assets/history-map/base_map_layer_2.jpg'
import postwar from '@/assets/history-map/base_map_layer_3.jpg'
import presentDay from '@/assets/history-map/base_map_layer_4.jpg'
import type {
  MapImages,
  MapImageSource
} from '@/components/history-map/MapImage'

async function imageVariants(src: ImageMetadata, requestedWidths: number[]) {
  const widths = requestedWidths
    .filter(width => width <= src.width)
    .filter((width, index, all) => all.indexOf(width) === index)
  const variants = await Promise.all(
    widths.map(width => getImage({ src, width, format: 'webp', quality: 90 }))
  )
  return {
    src: variants[variants.length - 1].src,
    srcSet: variants
      .map((image, index) => `${image.src} ${widths[index]}w`)
      .join(', '),
    width: widths[widths.length - 1],
    height: Math.round((src.height * widths[widths.length - 1]) / src.width)
  }
}

const [before1941Images, occupationImages, postwarImages, presentDayImages] =
  await Promise.all(
    [before1941, occupation, postwar, presentDay].map(src =>
      imageVariants(src, [480, 768, 1200, 1800, src.width])
    )
  )
const images: MapImages = {
  before1941: before1941Images,
  occupation: occupationImages,
  postwar: postwarImages,
  presentDay: presentDayImages
}

const poiModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/history-map/pois/*.webp',
  { eager: true }
)
const poiImages: Record<string, MapImageSource> = Object.fromEntries(
  await Promise.all(
    Object.entries(poiModules).map(async ([path, module]) => [
      `/assets/history-map/pois/${path.split('/').pop()}`,
      await imageVariants(module.default, [336, 672, 896])
    ])
  )
)
---

<BaseLayout
  title="Бабин Яр до 1941 року"
  description="Історична карта Бабиного Яру та прилеглих територій до 1941 року."
  flushMobileFooter
>
  <!-- URL fragments are only available in the browser. Avoid rendering the
       first scene on the server before the requested scene is known. -->
  <HistoryMap client:only="react" images={images} poiImages={poiImages}>
    <div slot="fallback" class="min-h-screen" aria-busy="true"></div>
  </HistoryMap>
</BaseLayout>
