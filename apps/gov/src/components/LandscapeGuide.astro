---
import LandscapeTimeline from '@/components/LandscapeTimeline.astro'
import { landscape } from './history-map/content/landscape'
import type { Language } from '@babyn-yar/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  lang: Language
}
const { lang } = Astro.props
const text = landscape[lang]
---

<BaseLayout title={text.title} description={text.description}>
  <LandscapeTimeline {lang} />
</BaseLayout>
