---
import { useTranslations, type Language } from '@babyn-yar/i18n'
import { createLocalizedPath } from '@/i18n-routing'
const { lang } = Astro.props as { lang: Language }
const path = createLocalizedPath(lang)
const t = useTranslations(lang)
// Coordinates and line breaks follow the supplied route illustration.
const stops = [
  {
    id: '01',
    x: 727,
    y: 337,
    tx: 722,
    ty: lang === 'en' ? 255 : 272,
    title: t('audioGuide.map.stop1.title').split('\n'),
    address: t('audioGuide.map.stop1.address').split('\n')
  },
  {
    id: '02',
    x: 618,
    y: 259,
    tx: 615,
    ty: 157,
    title: t('audioGuide.map.stop2.title').split('\n'),
    address: t('audioGuide.map.stop2.address').split('\n')
  },
  {
    id: '03',
    x: 343,
    y: 244,
    tx: 364,
    ty: 261,
    title: t('audioGuide.map.stop3.title').split('\n'),
    address: t('audioGuide.map.stop3.address').split('\n')
  },
  {
    id: '04',
    x: 26,
    y: 309,
    tx: 39,
    ty: 229,
    title: t('audioGuide.map.stop4.title').split('\n'),
    address: t('audioGuide.map.stop4.address').split('\n')
  },
  {
    id: '05',
    x: 21,
    y: 28,
    tx: 46,
    ty: 35,
    title: t('audioGuide.map.stop5.title').split('\n'),
    address: t('audioGuide.map.stop5.address').split('\n')
  }
]
---

<svg
  class="route-map my-16 block h-auto w-full overflow-visible"
  viewBox="0 0 930 365"
  xmlns="http://www.w3.org/2000/svg"
  aria-labelledby="map-title map-description"
>
  <title id="map-title">
    {t('audioGuide.map.title')}
  </title>
  <desc id="map-description">{t('audioGuide.map.description')}</desc>
  <path
    d="M727 337 L572 231 L366 190 L344 247 L323 308 L263 317 L26 309 L13 287 L20 267 L13 210 L1 194 L12 164 L12 98 L5 55 L21 28"
    fill="none"
    stroke="#ef2229"
    stroke-width="3"
    stroke-dasharray="18 8 3 8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  {
    stops.map((stop, index) => (
      <a
        href={path(`/guides/audio/${stop.id}`)}
        aria-label={`${t('audioGuide.stop')} ${index + 1}: ${stop.title.join(' ')}`}
      >
        <circle
          class="hit-area"
          cx={stop.x}
          cy={stop.y}
          r="24"
          fill="transparent"
        />
        <circle cx={stop.x} cy={stop.y} r="14" fill="#ef2229" />
        <text class="number" x={stop.x} y={stop.y + 8} text-anchor="middle">
          {index + 1}
        </text>
        <text
          class:list={['label', { final: index === 4 }]}
          x={stop.tx}
          y={stop.ty}
        >
          {stop.title.map((line, i) => (
            <tspan x={stop.tx} dy={i ? 20 : 0}>
              {line}
            </tspan>
          ))}
          {stop.address.map((line, i) => (
            <tspan class="address" x={stop.tx} dy={i ? 17 : 21}>
              {line}
            </tspan>
          ))}
        </text>
      </a>
    ))
  }
</svg>

<style>
  text {
    font-family: inherit;
  }
  .number {
    fill: white;
    font-size: 23px;
    font-weight: 700;
  }
  .label {
    fill: black;
    font-size: 20px;
    font-weight: 700;
  }
  .label.final {
    fill: #ef2229;
    font-size: 25px;
  }
  .address {
    fill: #777;
    font-size: 16px;
    font-weight: 400;
  }
  a:hover .label,
  a:focus-visible .label {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible .hit-area {
    stroke: black;
    stroke-width: 2px;
  }
</style>
