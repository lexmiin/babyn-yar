---
import type { Language } from '@babyn-yar/i18n'
import { createLocalizedPath } from '@/i18n-routing'
const { lang } = Astro.props as { lang: Language }
const path = createLocalizedPath(lang)
// Coordinates and line breaks follow the supplied route illustration.
const stops = [
  {
    id: '01',
    x: 727,
    y: 337,
    tx: 722,
    ty: 272,
    title: ['Перший блокпост'],
    address: ['перетин вул. Юрія Іллєнка', 'та Академіка Ромоданова']
  },
  {
    id: '02',
    x: 618,
    y: 259,
    tx: 615,
    ty: 157,
    title: ['Пам’ятний знак', '«Дорога смерті»'],
    address: ['перетин вул. Юрія Іллєнка', 'та Дорогожицької']
  },
  {
    id: '03',
    x: 343,
    y: 244,
    tx: 364,
    ty: 261,
    title: ['Військове', 'кладовище'],
    address: ['вул. Ґарета Джонса']
  },
  {
    id: '04',
    x: 26,
    y: 309,
    tx: 39,
    ty: 229,
    title: ['Майданчик для роздягання', 'євреїв перед розстрілом'],
    address: ['перетин вул. Дорогожицької', 'та Праведників']
  },
  {
    id: '05',
    x: 21,
    y: 28,
    tx: 46,
    ty: 35,
    title: ['Бабин Яр'],
    address: [
      'територія заповідника,',
      'поблизу пам’ятника дітям,',
      'розстріляним у Бабиному Яру'
    ]
  }
]
---

<svg
  class="route-map my-16 block h-auto w-full overflow-visible"
  viewBox="0 0 930 365"
  xmlns="http://www.w3.org/2000/svg"
  aria-labelledby="map-title map-description"
>
  <title id="map-title">Маршрут аудіогіду «Дорога пам’яті»</title>
  <desc id="map-description"
    >П’ять точок від першого блокпоста до Бабиного Яру. Виберіть точку, щоб
    відкрити її сторінку.</desc
  >
  <path
    d="M727 337 L572 231 L366 190 L344 247 L323 308 L263 317 L26 309 L13 287 L20 267 L13 210 L1 194 L12 164 L12 98 L5 55 L21 28"
    fill="none"
    stroke="#ef2229"
    stroke-width="3"
    stroke-dasharray="18 8 3 8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  {
    stops.map((stop, index) => (
      <a
        href={path(`/guides/audio/${stop.id}`)}
        aria-label={`Точка ${index + 1}: ${stop.title.join(' ')}`}
      >
        <circle
          class="hit-area"
          cx={stop.x}
          cy={stop.y}
          r="24"
          fill="transparent"
        />
        <circle cx={stop.x} cy={stop.y} r="14" fill="#ef2229" />
        <text class="number" x={stop.x} y={stop.y + 8} text-anchor="middle">
          {index + 1}
        </text>
        <text
          class:list={['label', { final: index === 4 }]}
          x={stop.tx}
          y={stop.ty}
        >
          {stop.title.map((line, i) => (
            <tspan x={stop.tx} dy={i ? 20 : 0}>
              {line}
            </tspan>
          ))}
          {stop.address.map((line, i) => (
            <tspan class="address" x={stop.tx} dy={i ? 17 : 21}>
              {line}
            </tspan>
          ))}
        </text>
      </a>
    ))
  }
</svg>

<style>
  text {
    font-family: inherit;
  }
  .number {
    fill: white;
    font-size: 23px;
    font-weight: 700;
  }
  .label {
    fill: black;
    font-size: 20px;
    font-weight: 700;
  }
  .label.final {
    fill: #ef2229;
    font-size: 25px;
  }
  .address {
    fill: #777;
    font-size: 16px;
    font-weight: 400;
  }
  a:hover .label,
  a:focus-visible .label {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: none;
  }
  a:focus-visible .hit-area {
    stroke: black;
    stroke-width: 2px;
  }
</style>
