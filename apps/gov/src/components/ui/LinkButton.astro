---
import { getLang } from '@babyn-yar/i18n'
import { createLocalizedPath } from '@/i18n-routing'

export interface Props {
  href: string
}

const { href } = Astro.props

const lang = getLang(Astro.currentLocale)
const translatePath = createLocalizedPath(lang)
---

<div class="mx-auto">
  <a
    href={translatePath(href)}
    class="rounded-sm border border-black/20 px-3 py-1 !not-italic no-underline transition-colors duration-200 hover:bg-black hover:text-white"
  >
    <slot />
  </a>
</div>
