---
export interface Props {
  siteTitle: string
  ogImage: string
  title: string
  description: string
  noindex?: boolean
  /** Page number of a paginated list, kept in the canonical when above 1. */
  canonicalPage?: number
}

const {
  title,
  description,
  siteTitle,
  ogImage,
  noindex = false,
  canonicalPage
} = Astro.props

const canonicalURL = new URL(
  Astro.url.pathname.replace(/([^/])$/, '$1/'),
  Astro.site
)
// Each page of a paginated list is its own canonical page. Pages opt in with
// canonicalPage, so a stray ?page= on any other route, like other query
// parameters (tracking, search filters), collapses onto the bare path.
if (canonicalPage && canonicalPage > 1) {
  canonicalURL.searchParams.set('page', String(canonicalPage))
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#ffffff" />
<meta name="generator" content={Astro.generator} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:title" content={title} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:type" content="website" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="canonical" href={canonicalURL} />
