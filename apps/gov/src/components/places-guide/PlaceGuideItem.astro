---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  id: string
  semanticId?: string
  title: string
  image: ImageMetadata
  alt: string
  orientation?: 'portrait' | 'landscape'
}

const {
  id,
  semanticId,
  title,
  image,
  alt,
  orientation = image.height > image.width ? 'portrait' : 'landscape'
} = Astro.props
---

<article
  id={id}
  class="scroll-mt-32"
  hidden
  data-guide-item
  data-guide-id={id}
  data-semantic-id={semanticId}
>
  <Image
    class:list={[
      'w-full',
      orientation === 'portrait'
        ? 'h-auto max-h-[min(75svh,45rem)] bg-[#f1f1f1] object-contain'
        : 'aspect-3/2 object-cover'
    ]}
    src={image}
    alt={alt}
    widths={[480, 768, 1200]}
    sizes="(min-width: 1024px) 960px, (min-width: 768px) calc(100vw - 142px), calc(100vw - 32px)"
    loading="lazy"
    decoding="async"
  />
  <div class="max-w-[76ch] px-4 pt-8 pb-16 md:px-0">
    <h1
      class="mt-0 mb-6 text-[clamp(2rem,7vw,3.4rem)] leading-[1.04] font-bold"
    >
      {title}
    </h1>
    <div class="guide-content">
      <slot />
    </div>
  </div>
</article>

<style>
  .guide-content :global(p) {
    margin-top: 1em;
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    line-height: 1.45;
  }

  .guide-content :global(p:first-of-type) {
    margin-top: 0;
  }

  .guide-content :global(section) {
    margin-top: 2.5rem;
  }

  .guide-content :global(h2) {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    line-height: calc(2 / 1.5);
    font-weight: 700;
  }

  .guide-content :global(a) {
    text-decoration-line: underline;
  }
</style>
