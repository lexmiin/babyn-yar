---
import BaseError from './BaseError.astro'
import { getLang, useTranslations } from '@babyn-yar/i18n'

const lang = getLang(Astro.currentLocale)
const t = useTranslations(lang)
---

<BaseError code={500}>
  <Fragment slot="title">{t('error.500.title')}</Fragment>
  <Fragment slot="description">
    {t('error.500.description')}
  </Fragment>
</BaseError>
